# Salin ke .env.local dan sesuaikan nilainya.

MONGO_URL=
DB_NAME=arasvara_news

# Default true — artikel baru memakai URL structured (/news/kategori/yyyy/mm/dd/slug).
# Set false untuk rollback ke legacy-only pada artikel baru.
ARTICLE_STRUCTURED_URL_ENABLED=true

# TTL ISR halaman detail artikel (detik). Opsional.
# ARTICLE_PAGE_REVALIDATE_SECONDS=3600
